global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - "/etc/prometheus/alert.rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "{{ alertmanager_host }}"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Цикл генерирует остальные таргеты
{% for item in prometheus_scrape_configs %}
  - job_name: '{{ item.job_name }}'
    static_configs:
      - targets: ['{{ item.target }}']
{% endfor %}