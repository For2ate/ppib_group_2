server {
    listen 80;
    server_name {{ proxy_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ proxy_domain }};

    ssl_certificate /etc/ssl/private/{{ ssl_cert_file }};
    ssl_certificate_key /etc/ssl/private/{{ ssl_key_file }};

    client_max_body_size 100M;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # --- Portainer ---
    location /portainer/ {
        
        proxy_pass {{ proxy_upstream_portainer }}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # --- DBeaver ---
    location /dbeaver/ {

        proxy_pass {{ proxy_upstream_dbeaver }};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # --- Grafana ---
    location /grafana/ {

        proxy_pass {{ proxy_upstream_grafana }}/grafana/;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_redirect default;
    }

    # --- Elgg ---
    location /elgg/ {
        rewrite ^/elgg/(.*) /$1 break;
        
        proxy_pass {{ proxy_upstream_elgg }};

        proxy_set_header Accept-Encoding "";
        sub_filter 'href="/'  'href="/elgg/';
        sub_filter 'src="/'   'src="/elgg/';
        sub_filter 'action="/' 'action="/elgg/';
        sub_filter_once off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}